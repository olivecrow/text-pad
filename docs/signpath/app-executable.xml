<?xml version="1.0" encoding="utf-8"?>
<!-- 신청 준비용 초안. 재단 승인과 서비스 스키마 검증 뒤 사용한다. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="text-pad.exe" product-name="text-pad" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
