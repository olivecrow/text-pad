<?xml version="1.0" encoding="UTF-8"?>
<?if $(sys.BUILDARCH)="x86"?>
  <?define TextPadWin64 = "no" ?>
<?else?>
  <?define TextPadWin64 = "yes" ?>
<?endif?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="DefaultAppCapabilities" Guid="08d30e3a-4f67-427e-95c1-8f93ab4edb28" Win64="$(var.TextPadWin64)">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="text-pad" Type="string" Value="Software\text-pad\Capabilities" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\text-pad\Capabilities" Name="ApplicationName" Type="string" Value="text-pad" />
        <RegistryValue Root="HKLM" Key="Software\text-pad\Capabilities" Name="ApplicationDescription" Type="string" Value="text-pad supported text file editor" />
        <RegistryValue Root="HKLM" Key="Software\text-pad\Capabilities" Name="ApplicationIcon" Type="string" Value="[INSTALLDIR]text-pad.exe,0" />
        <RegistryKey Root="HKLM" Key="Software\text-pad\Capabilities\FileAssociations">
          <RegistryValue Name=".txt" Type="string" Value="text-pad.txt" />
          <RegistryValue Name=".text" Type="string" Value="text-pad.text" />
          <RegistryValue Name=".md" Type="string" Value="text-pad.md" />
          <RegistryValue Name=".markdown" Type="string" Value="text-pad.markdown" />
          <RegistryValue Name=".json" Type="string" Value="text-pad.json" />
          <RegistryValue Name=".jsonc" Type="string" Value="text-pad.jsonc" />
          <RegistryValue Name=".jsonl" Type="string" Value="text-pad.jsonl" />
          <RegistryValue Name=".ndjson" Type="string" Value="text-pad.ndjson" />
          <RegistryValue Name=".xml" Type="string" Value="text-pad.xml" />
          <RegistryValue Name=".xsd" Type="string" Value="text-pad.xsd" />
          <RegistryValue Name=".xsl" Type="string" Value="text-pad.xsl" />
          <RegistryValue Name=".xslt" Type="string" Value="text-pad.xslt" />
