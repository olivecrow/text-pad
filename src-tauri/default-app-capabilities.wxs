<?xml version="1.0" encoding="UTF-8"?>
<?if $(sys.BUILDARCH)="x86"?>
  <?define TextPadWin64 = "no" ?>
<?else?>
  <?define TextPadWin64 = "yes" ?>
<?endif?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="DefaultAppCapabilities" Guid="08d30e3a-4f67-427e-95c1-8f93ab4edb28" Win64="$(var.TextPadWin64)">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="text-pad" Type="string" Value="Software\text-pad\Capabilities" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\text-pad\Capabilities" Name="ApplicationName" Type="string" Value="text-pad" />
        <RegistryValue Root="HKLM" Key="Software\text-pad\Capabilities" Name="ApplicationDescription" Type="string" Value="text-pad supported text file editor" />
        <RegistryValue Root="HKLM" Key="Software\text-pad\Capabilities" Name="ApplicationIcon" Type="string" Value="[INSTALLDIR]text-pad.exe,0" />
        <RegistryKey Root="HKLM" Key="Software\text-pad\Capabilities\FileAssociations">
          <RegistryValue Name=".txt" Type="string" Value="text-pad.txt" />
          <RegistryValue Name=".text" Type="string" Value="text-pad.text" />
          <RegistryValue Name=".md" Type="string" Value="text-pad.md" />
          <RegistryValue Name=".markdown" Type="string" Value="text-pad.markdown" />
          <RegistryValue Name=".json" Type="string" Value="text-pad.json" />
          <RegistryValue Name=".jsonl" Type="string" Value="text-pad.jsonl" />
          <RegistryValue Name=".ndjson" Type="string" Value="text-pad.ndjson" />
          <RegistryValue Name=".csv" Type="string" Value="text-pad.csv" />
          <RegistryValue Name=".tsv" Type="string" Value="text-pad.tsv" />
          <RegistryValue Name=".yaml" Type="string" Value="text-pad.yaml" />
          <RegistryValue Name=".yml" Type="string" Value="text-pad.yml" />
          <RegistryValue Name=".ini" Type="string" Value="text-pad.ini" />
          <RegistryValue Name=".cfg" Type="string" Value="text-pad.cfg" />
          <RegistryValue Name=".conf" Type="string" Value="text-pad.conf" />
          <RegistryValue Name=".properties" Type="string" Value="text-pad.properties" />
          <RegistryValue Name=".env" Type="string" Value="text-pad.env" />
          <RegistryValue Name=".log" Type="string" Value="text-pad.log" />
          <RegistryValue Name=".srt" Type="string" Value="text-pad.srt" />
          <RegistryValue Name=".vtt" Type="string" Value="text-pad.vtt" />
          <RegistryValue Name=".lrc" Type="string" Value="text-pad.lrc" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\text-pad.exe">
          <RegistryValue Name="FriendlyAppName" Type="string" Value="text-pad" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]text-pad.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
          <RegistryKey Key="SupportedTypes">
            <RegistryValue Name=".txt" Type="string" Value="" />
            <RegistryValue Name=".text" Type="string" Value="" />
            <RegistryValue Name=".md" Type="string" Value="" />
            <RegistryValue Name=".markdown" Type="string" Value="" />
            <RegistryValue Name=".json" Type="string" Value="" />
            <RegistryValue Name=".jsonl" Type="string" Value="" />
            <RegistryValue Name=".ndjson" Type="string" Value="" />
            <RegistryValue Name=".csv" Type="string" Value="" />
            <RegistryValue Name=".tsv" Type="string" Value="" />
            <RegistryValue Name=".yaml" Type="string" Value="" />
            <RegistryValue Name=".yml" Type="string" Value="" />
            <RegistryValue Name=".ini" Type="string" Value="" />
            <RegistryValue Name=".cfg" Type="string" Value="" />
            <RegistryValue Name=".conf" Type="string" Value="" />
            <RegistryValue Name=".properties" Type="string" Value="" />
            <RegistryValue Name=".env" Type="string" Value="" />
            <RegistryValue Name=".log" Type="string" Value="" />
            <RegistryValue Name=".srt" Type="string" Value="" />
            <RegistryValue Name=".vtt" Type="string" Value="" />
            <RegistryValue Name=".lrc" Type="string" Value="" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
