          <RegistryValue Name=".env" Type="string" Value="text-pad.env" />
          <RegistryValue Name=".gitignore" Type="string" Value="text-pad.gitignore" />
          <RegistryValue Name=".gitattributes" Type="string" Value="text-pad.gitattributes" />
