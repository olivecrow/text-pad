          <RegistryValue Name=".lrc" Type="string" Value="text-pad.lrc" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\Applications\text-pad.exe">
          <RegistryValue Name="FriendlyAppName" Type="string" Value="text-pad" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]text-pad.exe&quot; &quot;%1&quot;" />
