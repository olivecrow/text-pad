          <RegistryValue Name=".po" Type="string" Value="text-pad.po" />
          <RegistryValue Name=".pot" Type="string" Value="text-pad.pot" />
          <RegistryValue Name=".csv" Type="string" Value="text-pad.csv" />
          <RegistryValue Name=".tsv" Type="string" Value="text-pad.tsv" />
          <RegistryValue Name=".yaml" Type="string" Value="text-pad.yaml" />
          <RegistryValue Name=".yml" Type="string" Value="text-pad.yml" />
          <RegistryValue Name=".toml" Type="string" Value="text-pad.toml" />
          <RegistryValue Name=".ini" Type="string" Value="text-pad.ini" />
