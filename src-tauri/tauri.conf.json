{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "text-pad",
  "version": "0.4.0",
  "identifier": "com.textpad.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "제목 없음 - 메모장",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "copyright": "Copyright © 2026 olivecrow. All rights reserved.",
    "publisher": "text-pad",
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "text",
          "md",
          "markdown",
          "json",
          "jsonc",
          "jsonl",
          "ndjson",
          "xml",
          "xsd",
          "xsl",
          "xslt",
          "rss",
          "atom",
          "po",
          "pot",
          "csv",
          "tsv",
          "yaml",
          "yml",
          "toml",
          "ini",
          "cfg",
          "conf",
          "properties",
          "env",
          "gitignore",
          "gitattributes",
          "gitconfig",
          "gitmodules",
          "editorconfig",
          "npmrc",
          "dockerignore",
          "ignore",
          "npmignore",
          "prettierignore",
          "eslintignore",
          "stylelintignore",
          "helmignore",
          "vercelignore",
          "cursorignore",
          "rgignore",
          "fdignore",
          "gitmessage",
          "mailmap",
          "reg",
          "service",
          "socket",
          "timer",
          "target",
          "path",
          "mount",
          "automount",
          "swap",
          "slice",
          "scope",
          "network",
          "netdev",
          "link",
          "log",
          "srt",
          "vtt",
          "lrc"
        ],
        "name": "text-pad document",
        "description": "text-pad supported text file",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      },
      "wix": {
        "fragmentPaths": [
          "default-app-capabilities.wxs"
        ],
        "componentRefs": [
          "DefaultAppCapabilities"
        ]
      }
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzQkUyN0IwNzhDMDhBQTkKUldTcGlzQjRzQ2Urbzh3dG9XWUYzNld0OVJ1WEhIUXZLY1VGUDBLSHM1cG1Hbkh1VnV6L3lHa0EK",
      "endpoints": [
        "https://github.com/olivecrow/text-pad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
