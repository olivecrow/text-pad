{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "text-pad",
  "version": "0.1.0",
  "identifier": "com.textpad.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "제목 없음 - 메모장",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "text-pad",
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "json",
          "yaml",
          "yml"
        ],
        "name": "text-pad document",
        "description": "text-pad supported text file",
        "role": "Editor"
      }
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
