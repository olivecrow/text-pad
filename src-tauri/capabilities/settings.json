{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Minimal capability for the settings window",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-hide",
    "allow-open-file-dialog",
    "allow-set-separate-virtual-desktop-windows",
    "allow-save-file-dialog"
  ]
}
